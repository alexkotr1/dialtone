# Dependencies
node_modules/

# Generated at install time (npm run build:vendor), not source
vendor/

# Generated by tools/make-icon.js — but the icons themselves are committed.
# They are what the tray and the shortcut use, and a fresh clone that shows a
# blank tray icon looks broken. Regenerate with `npm run build:icon`.
build/*
!build/icon.ico
!build/icon.png

# Scratch output from the dev harness
*.log
*.err
test/.*.tmp.js

# Never. Credentials live on the machines that need them:
#   - the SIP password goes through the OS keystore, in %APPDATA%\dialtone
#   - the trunk credentials live on the Pi, root-only, in
#     /home/alex/dialtone-fs/conf/vars/dialtone_vars.xml
# If either ever ends up in a file here, it is a mistake, not a convenience.
*.pem
*.key
credentials.bin
dialtone_vars.xml
*secrets*
.env

# Packaged output (npm run dist). ~100MB per build; distribute via a release,
# not the repo.
dist/
