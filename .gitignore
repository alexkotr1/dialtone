# Dependencies
node_modules/

# Generated at install time (npm run build:vendor), not source
vendor/

# Generated by tools/make-icon.js
build/

# Scratch output from the dev harness
*.log
*.err
test/.*.tmp.js

# Never. Credentials live on the machines that need them:
#   - the SIP password goes through the OS keystore, in %APPDATA%\dialtone
#   - the trunk credentials live on the Pi, root-only, in
#     /home/alex/dialtone-fs/conf/vars/dialtone_vars.xml
# If either ever ends up in a file here, it is a mistake, not a convenience.
*.pem
*.key
credentials.bin
dialtone_vars.xml
*secrets*
.env
